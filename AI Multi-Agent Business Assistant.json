      "parameters": {
        "jsCode": "let raw = $input.first().json.output[0].content[0].text;\n\n// Strip markdown code fences if present\nraw = raw.replace(/```json\\s*/g, '').replace(/```\\s*/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  throw new Error(\"Orchestrator did not return valid JSON: \" + raw);\n}\n\nreturn [{\n  json: {\n    customer_name: $('Code in JavaScript').first().json.customer_name,\n    customer_email: $('Code in JavaScript').first().json.customer_email,\n    original_message: $('Code in JavaScript').first().json.message,\n    needs_scheduling: parsed.needs_scheduling,\n    needs_knowledge_answer: parsed.needs_knowledge_answer,\n    needs_escalation: parsed.needs_escalation,\n    scheduling_preference: parsed.scheduling_preference,\n    knowledge_question: parsed.knowledge_question\n  }\n}];"
